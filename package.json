{
  "name": "e6studio",
  "version": "2.4.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "android:sync": "npm run android:android8 && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && npm run android:open",
    "android:add": "npx cap add android",
    "android:android8": "node scripts/set-android8-sdk.js"
  },
  "build": {
    "appId": "com.e6studio.app",
    "productName": "E6 Studio",
    "icon": "public/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "nikito2223",
        "repo": "E6Studio"
      }
    ],
    "files": [
      "**/*",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "keywords": [],
  "author": {
    "name": "Rufik",
    "email": "mmkzmkzkz81@gmail.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.11.0",
    "core-util-is": "^1.0.3",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.6.2"
  }
}