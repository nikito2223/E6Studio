<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/post_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/openSidebarBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/post_item_bg"
                android:contentDescription="menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/app_primary_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E6Studio"
                    android:textColor="@color/app_primary_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Умный клиент для e621"
                    android:textColor="@color/app_secondary_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/post_item_bg"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="@color/app_primary_text" />

            <ImageButton
                android:id="@+id/incognitoBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/post_item_bg"
                android:src="@android:drawable/ic_menu_view"
                android:tint="@color/app_primary_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/post_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Напишите теги или вставьте ссылку e621"
                android:imeOptions="actionSearch"
                android:paddingHorizontal="10dp"
                android:textColor="@color/app_primary_text"
                android:textColorHint="@color/app_secondary_text" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Открыть" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/post_item_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Нет интернета. Подключитесь к сети и попробуйте снова."
                android:textColor="@color/app_warning"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retryConnectionBtn"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Повторить" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/post_item_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Домашняя страница"
                android:textColor="@color/app_primary_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Пока здесь пусто — напишите запрос в поиск, откройте ссылку e621 или выберите быстрый режим ниже."
                android:textColor="@color/app_secondary_text" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/quickPopularBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Популярное" />

                    <Button
                        android:id="@+id/quickNewBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="Новое" />

                    <Button
                        android:id="@+id/quickFavoritesBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="Избранное" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/menuPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Популярное"
                    android:textColor="@color/app_primary_text" />

                <RadioButton
                    android:id="@+id/menuNew"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Новое"
                    android:textColor="@color/app_primary_text" />

                <RadioButton
                    android:id="@+id/menuFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Избранное"
                    android:textColor="@color/app_primary_text" />

                <RadioButton
                    android:id="@+id/menuHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="История"
                    android:textColor="@color/app_primary_text" />
            </RadioGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prevPageBtn"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:text="←" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/app_primary_text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/nextPageBtn"
                android:layout_width="46dp"
                android:layout_height="36dp"
                android:text="→" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/post_item_bg"
            android:gravity="center"
            android:padding="18dp"
            android:text="Ничего не найдено"
            android:textColor="@color/app_primary_text"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/galleryRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarRoot"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/app_surface"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/sidebarSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/post_item_bg"
            android:hint="Поиск тегов..."
            android:paddingHorizontal="10dp"
            android:textColor="@color/app_primary_text"
            android:textColorHint="@color/app_secondary_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Теги"
            android:textColor="@color/app_accent"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tagList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Фильтры"
            android:textColor="@color/app_accent"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterList"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Коллекции"
            android:textColor="@color/app_accent"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionList"
            android:layout_width="match_parent"
            android:layout_height="90dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
