<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111A">

    <LinearLayout
        android:id="@+id/mainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/openSidebarBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/post_item_bg"
                android:contentDescription="menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#E8F1F7" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="E6 Studio"
                android:textColor="#E8F1F7"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/post_item_bg"
                android:src="@android:drawable/ic_menu_manage"
                android:tint="#E8F1F7" />

            <ImageButton
                android:id="@+id/incognitoBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/post_item_bg"
                android:src="@android:drawable/ic_menu_view"
                android:tint="#E8F1F7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/post_item_bg"
                android:hint="Поиск тегов..."
                android:paddingHorizontal="12dp"
                android:textColor="#E8F1F7"
                android:textColorHint="#8EA4B6" />

            <Button
                android:id="@+id/searchButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="Найти" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <RadioGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/menuPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Популярное"
                    android:textColor="#E8F1F7" />

                <RadioButton
                    android:id="@+id/menuNew"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Новое"
                    android:textColor="#E8F1F7" />

                <RadioButton
                    android:id="@+id/menuFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="Избранное"
                    android:textColor="#E8F1F7" />

                <RadioButton
                    android:id="@+id/menuHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:button="@null"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:text="История"
                    android:textColor="#E8F1F7" />
            </RadioGroup>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prevPageBtn"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:text="←" />

            <TextView
                android:id="@+id/pageLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1"
                android:textColor="#E8F1F7" />

            <Button
                android:id="@+id/nextPageBtn"
                android:layout_width="40dp"
                android:layout_height="34dp"
                android:text="→" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Ничего не найдено"
            android:textColor="#E8F1F7"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/galleryRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarRoot"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0D1B26"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/sidebarSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/post_item_bg"
            android:hint="Поиск тегов..."
            android:paddingHorizontal="10dp"
            android:textColor="#E8F1F7"
            android:textColorHint="#8EA4B6" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Теги"
            android:textColor="#56D8C9"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tagList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Фильтры"
            android:textColor="#56D8C9"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterList"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Коллекции"
            android:textColor="#56D8C9"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/collectionList"
            android:layout_width="match_parent"
            android:layout_height="90dp" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
